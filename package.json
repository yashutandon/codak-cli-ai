{
  "name": "codak",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -c \"cyan.bold,magenta.bold,green.bold\" -n \"server,worker,web\" \"bun run dev:server\" \"bun run dev:worker\" \"bun run dev:web\"",
    "dev:server": "bun run --watch packages/server/src/index.ts",
    "dev:worker": "bun run --watch packages/server/src/worker.ts",
    "dev:web": "bun --cwd packages/web dev",
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "cli": "bun run packages/cli/src/index.tsx",
    "start:cli": "start cmd /k bun run dev:cli",
    "typecheck": "cd packages/server && bun run typecheck && cd ../web && bun run typecheck",
    "test": "cd packages/server && bun run test",
    "check-all": "bun run check-all.ts",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "glob": "^13.0.6",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7"
  }
}
