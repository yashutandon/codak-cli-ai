generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

model ToolExecution {
  id        String   @id @default(cuid())
  sessionId String
  toolName  String
  args      Json
  result    String
  duration  Int
  error     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CodeChunk {
  id        String                      @id @default(cuid())
  sessionId String
  filePath  String
  content   String
  embedding Unsupported("vector(3072)")?
  startLine Int
  endLine   Int
  createdAt DateTime                    @default(now())
  session   Session                     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String?   // null for OAuth users
  isOAuthUser Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]

  @@index([email])
}

model Session {
  id             String          @id @default(cuid())
  userId         String
  title          String
  cwd            String?
  codeChunks     CodeChunk[]
  toolExecutions ToolExecution[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       Message[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  sessionId String
  role      Role
  status    MessageStatus
  content   String
  title     String        @default("")
  mode      Mode
  model     String
  part      Json?
  duration  Int?
  createdAt DateTime      @default(now())
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}