generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model ToolExecution {
  id        String   @id @default(cuid())
  sessionId String
  toolName  String
  args      Json
  result    String
  duration  Int
  error     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CodeChunk {
  id        String                      @id @default(cuid())
  sessionId String
  filePath  String
  content   String
  embedding Unsupported("vector(1024)")?
  startLine Int
  endLine   Int
  createdAt DateTime                    @default(now())
  session   Session                     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String?        // null for OAuth users
  isOAuthUser   Boolean        @default(false)
  tier          SubscriptionTier @default(FREE)
  razorpayCustomerId String?   @unique
  razorpaySubscriptionId String? @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  refreshTokens RefreshToken[]
  usageTokens   UsageToken[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  selector  String    @unique @default(uuid()) // first UUID segment — used for fast O(1) lookup
  tokenHash String    @unique  // bcrypt hash of the raw token (verified after lookup)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?           // null = active
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([selector])
}

model Session {
  id             String          @id @default(cuid())
  userId         String
  title          String
  cwd            String?
  codeChunks     CodeChunk[]
  toolExecutions ToolExecution[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       Message[]
  usageTokens    UsageToken[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  sessionId String
  role      Role
  status    MessageStatus
  content   String
  title     String        @default("")
  mode      Mode
  model     String
  part      Json?
  duration  Int?
  createdAt DateTime      @default(now())
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model UsageToken {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Float?   @default(0.0) // Optionally track USD/INR cost based on model pricing
  createdAt        DateTime @default(now())
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
}